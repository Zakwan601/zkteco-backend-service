# Environment variables and secrets
.env
.env.*
!.env.example

# Virtual environments
.venv/
venv/
env/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Test, type-checker, and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Build and packaging output
build/
dist/
*.egg-info/

# Local synchronization state
data/state.json
data/*.tmp

# Runtime logs
logs/*
!logs/.gitkeep

# IDE and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
